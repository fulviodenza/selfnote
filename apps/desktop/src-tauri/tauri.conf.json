{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Selfnote",
  "version": "0.1.0",
  "identifier": "app.selfnote.desktop",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm --filter @selfnote/web dev",
    "beforeBuildCommand": "pnpm --filter @selfnote/web build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Selfnote",
        "width": 1200,
        "height": 800,
        "minWidth": 640,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["selfnote"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
