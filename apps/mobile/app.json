{
  "expo": {
    "name": "Selfnote",
    "slug": "selfnote",
    "scheme": "selfnote",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#faf5ef"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.selfnote.mobile"
    },
    "android": {
      "package": "app.selfnote.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#faf5ef"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-asset",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/feather.ttf",
            "./node_modules/@expo-google-fonts/newsreader/500Medium/Newsreader_500Medium.ttf",
            "./node_modules/@expo-google-fonts/newsreader/600SemiBold/Newsreader_600SemiBold.ttf",
            "./node_modules/@expo-google-fonts/inter-tight/400Regular/InterTight_400Regular.ttf",
            "./node_modules/@expo-google-fonts/inter-tight/500Medium/InterTight_500Medium.ttf",
            "./node_modules/@expo-google-fonts/inter-tight/600SemiBold/InterTight_600SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinVersion": "1.9.24"
          }
        }
      ]
    ]
  }
}
