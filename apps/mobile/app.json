{
  "expo": {
    "name": "Selfnote",
    "slug": "selfnote",
    "scheme": "selfnote",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#faf5ef"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.selfnote.mobile"
    },
    "android": {
      "package": "app.selfnote.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#faf5ef"
      }
    },
    "plugins": [
      "expo-sqlite",
      "expo-asset",
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/feather.ttf"
          ]
        }
      ]
    ]
  }
}
