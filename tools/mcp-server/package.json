{
  "name": "@selfnote/mcp",
  "version": "0.1.0",
  "description": "MCP server for Selfnote — let Claude (CLI, Desktop, or claude.ai) file conversation summaries into your self-hosted Selfnote instance.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bin": {
    "selfnote-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@blocknote/core": "^0.54.0",
    "@blocknote/server-util": "^0.54.0",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "express": "^4.21.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.6",
    "yjs": "^13.6.18",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "typescript": "^5.5.4"
  }
}
